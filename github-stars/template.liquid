<div style="font-family: sans-serif; padding: 24px 28px; background: #fff; color: #000; height: 480px; width: 800px; position: relative; overflow: hidden;">
  
  <!-- Decorative stars scattered -->
  <div style="position: absolute; top: 12px; right: 24px; font-size: 32px; opacity: 0.15;">✦ ✧ ★ ✦</div>
  <div style="position: absolute; bottom: 20px; left: 24px; font-size: 24px; opacity: 0.1;">✧ ★ ✦ ✧ ★</div>
  <div style="position: absolute; top: 80px; right: 40px; font-size: 18px; opacity: 0.08;">✦</div>
  <div style="position: absolute; bottom: 120px; right: 60px; font-size: 14px; opacity: 0.08;">✧</div>

  <!-- Header -->
  <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 20px; border-bottom: 3px solid #000; padding-bottom: 12px;">
    <div style="font-size: 28px; font-weight: 800; letter-spacing: -0.5px;">★ GitHub Stars</div>
    <div style="font-size: 11px; color: #666;">{{ updated }}</div>
  </div>

  <!-- Repos -->
  {% for i in (1..5) %}
  {% assign name_key = 'repo_' | append: i | append: '_name' %}
  {% assign stars_key = 'repo_' | append: i | append: '_stars' %}
  {% assign lang_key = 'repo_' | append: i | append: '_lang' %}
  {% assign desc_key = 'repo_' | append: i | append: '_desc' %}
  
  <div style="display: flex; justify-content: space-between; align-items: center; padding: 10px 0; {% unless forloop.last %}border-bottom: 1px dashed #ccc;{% endunless %}">
    <div style="flex: 1; padding-right: 16px;">
      <div style="font-size: 15px; font-weight: 700;">
        <span style="color: #999; font-size: 13px; margin-right: 4px;">{{ i }}.</span>
        {{ [name_key] }}
      </div>
      <div style="font-size: 11px; color: #777; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 480px;">{{ [desc_key] }}</div>
    </div>
    <div style="text-align: right; min-width: 110px;">
      <div style="font-size: 20px; font-weight: 800;">★ {{ [stars_key] }}</div>
      <div style="font-size: 10px; color: #888; text-transform: uppercase; letter-spacing: 1px;">{{ [lang_key] }}</div>
    </div>
  </div>
  {% endfor %}
</div>
